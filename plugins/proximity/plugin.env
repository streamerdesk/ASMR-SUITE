# Metadatos del plugin
PLUGIN_ID="streamerdesk-asmr-proximity"
PLUGIN_DISPLAY="Streamerdesk ASMR - Proximidad"
PLUGIN_PRODUCT="StreamerdeskASMR-Proximidad"
PLUGIN_VERSION="1.0.0"
PLUGIN_VENDOR="Streamerdesk"
PLUGIN_URL="https://streamerdesk.com"
OBS_MIN_VERSION="28.0.0"
PLUGIN_BUNDLE_ID="com.streamerdesk.asmr.proximity"
PLUGIN_SOURCES="src/plugin-main.c src/proximity_dsp.c"
PLUGIN_TESTS="test/test_proximity.c src/proximity_dsp.c"
PLUGIN_PLATFORMS="windows macos linux"
# Flags del proyecto original (scripts/build-windows.sh), para reproducir el binario publicado
PLUGIN_CFLAGS="-Wno-unused-parameter -Wno-missing-field-initializers -fno-strict-aliasing"
PLUGIN_CFLAGS_WINDOWS="-DUNICODE -D_UNICODE -DWIN32_LEAN_AND_MEAN"
PLUGIN_LDFLAGS_WINDOWS="-Wl,--subsystem,windows"
